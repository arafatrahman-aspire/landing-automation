PORT=4300

# Research / guide / static copy
# AI_PROVIDER=gemini
AI_PROVIDER=gemini

# Section coding agent

OMNIROUTE_BASE_URL=http://localhost:20128/v1
# gemini-web / gweb needs Playwright inside the OmniRoute container and 500s
# there. Use the Google AI Studio provider OmniRoute already has connected.
OMNIROUTE_MODEL=

OMNIROUTE_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CODING_AGENT_PROVIDER=gemini
CODING_AGENT_MODEL=gemini-2.5-flash

MAX_AGENT_ITERATIONS=40
MAX_CODE_ATTEMPTS=3
# This target repo has both a package-lock.json and a stale yarn.lock —
# force npm instead of letting auto-detection pick yarn.
PACKAGE_MANAGER_OVERRIDE=npm
# Verify and preview run plain host npm (npm ci / npm run build / npm run start)
# instead of building inside the target repo's Dockerfile. This is the default
# since v0.32; set to false only if you deliberately want the container path.
VERIFY_DISABLE_DOCKER=true
VERIFY_INSTALL_TIMEOUT_MS=300000
VERIFY_BUILD_TIMEOUT_MS=600000

# --- Target repo: REAL repo, real PR will be opened ---
GITHUB_TOKEN=
GITHUB_TARGET_OWNER=arafatrahman-aspire
GITHUB_TARGET_REPO=atss-frontend
GITHUB_BASE_BRANCH=dev
GITHUB_API_URL=https://api.github.com
# unset: owner+repo above already construct the correct clone URL
TARGET_REPO_CLONE_URL=
DRY_RUN_NO_PR=false

WRITE_PATH_ALLOWLIST=src/app/campaigns/{slug}/

# The route the generated page is served at — the Next app-router path that
# WRITE_PATH_ALLOWLIST above produces. Without this the preview opens the
# target repo's HOME PAGE instead of the campaign, and the hero-fit/SEO/a11y
# checks are skipped entirely.
PAGE_URL_PATH_TEMPLATE=/campaigns/{slug}

GIT_AUTHOR_NAME="Landing Page Bot"
GIT_AUTHOR_EMAIL="arafat.rahman@aspiretss.com"

DB_PATH=./data/campaigns.db
WORKDIR_ROOT=./data/.scratch
KEEP_WORKDIR_ON_FAILURE=true

SKIP_RESEARCH=false

# Stage a draft for review even when verify still fails after every retry.
# The run is flagged and the review UI warns loudly that the page does NOT
# build — approving it can open a PR with code that doesn't compile.
CONTINUE_ON_VERIFY_FAILURE=true

# Disabled for now — hero-fit/a11y were flagging narrow/false-positive-feeling
# failures during generation tuning. Re-enable once section generation is
# more reliably fitting the mobile viewport and using explicit text colors.
ENABLE_HERO_FIT_CHECK=false
ENABLE_A11Y_CHECK=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PEXELS_API_KEY=
SERPAPI_API_KEY=
SUPABASE_STORAGE_BUCKET=campaign-images
# CMS login. Use the same secret as CMS's LANDING_PAGE_SECRET.
# Callbacks, API paths, timeouts and normal development/Docker routing are automatic.
APP_PUBLIC_URL=
CMS_PUBLIC_URL=
SSO_CLIENT_SECRET=

# Remote hosting only: serve every preview through one public port as
# http://<token>.<PREVIEW_PUBLIC_HOST>:<PREVIEW_GATEWAY_PORT>. PREVIEW_PUBLIC_HOST
# must be a wildcard-DNS name for this host, distinct from APP_PUBLIC_URL's,
# e.g. 84-46-241-116.sslip.io. Leave unset locally (previews stay on loopback).
# PREVIEW_PUBLIC_HOST=
# PREVIEW_GATEWAY_PORT=5190
